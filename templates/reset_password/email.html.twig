<!doctype html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SmartRide Password Reset</title>
    <style>
        @media only screen and (max-width: 620px) {
            .container { width: 100% !important; padding: 0 !important; }
            .content { padding: 24px !important; }
            .btn a { padding: 12px 18px !important; font-size: 16px !important; }
            .h1 { font-size: 22px !important; }
            .lead { font-size: 15px !important; }
        }
        body {
            margin: 0; padding: 0;
            background-color: #f6f9fc;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', Arial, sans-serif;
            color: #0f172a;
        }
        .container {
            width: 100%;
            background-color: #f6f9fc;
            padding: 24px;
        }
        .card {
            max-width: 640px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            border: 1px solid #eef2f7;
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #1abc9c, #16a085);
            padding: 24px;
            color: #ffffff;
            text-align: center;
        }
        .brand {
            font-weight: 800;
            letter-spacing: 0.4px;
            font-size: 16px;
            opacity: 0.95;
        }
        .h1 {
            margin: 10px 0 0 0;
            font-size: 24px;
            font-weight: 800;
        }
        .content {
            padding: 28px 28px 22px 28px;
        }
        .lead {
            font-size: 16px;
            line-height: 1.7;
            color: #334155;
            margin: 0 0 16px 0;
        }
        .btn {
            text-align: center;
            margin: 22px 0 10px 0;
        }
        .btn a {
            display: inline-block;
            background: #1abc9c;
            color: #ffffff !important;
            text-decoration: none;
            font-weight: 700;
            border-radius: 12px;
            padding: 14px 22px;
        }
        .meta {
            margin-top: 16px;
            font-size: 13px;
            color: #64748b;
        }
        .footer {
            padding: 18px 28px 26px 28px;
            border-top: 1px solid #f1f5f9;
            font-size: 12px;
            color: #94a3b8;
            text-align: center;
        }
        .link {
            color: #0ea5e9 !important;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
                <td>
                    <div class="card">
                        <div class="header">
                            <div class="brand">SmartRide</div>
                            <div class="h1">Reset Your Password</div>
                        </div>
                        <div class="content">
                            <p class="lead">
                                To reset your password, click the button below. If you did not request this, you can safely ignore this email.
                            </p>
                            <div class="btn">
                                <a href="{{ url('app_reset_password', {token: resetToken.token}) }}">Reset Password</a>
                            </div>
                            <p class="meta">
                                This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                            </p>
                            <p class="meta">
                                If the button doesn’t work, copy and paste this URL into your browser:
                                <br>
                                <a class="link" href="{{ url('app_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>
                            </p>
                        </div>
                        <div class="footer">
                            © {{ "now"|date("Y") }} SmartRide. All rights reserved.
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
