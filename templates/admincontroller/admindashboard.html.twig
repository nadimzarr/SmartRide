<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - SMARTRIDE</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <style>
        :root {
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --topbar-bg: #f8f9fa;
            --primary-color: #3b82f6;
            --card-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-image: url('{{ asset('images/taraji.jpg') }}');
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            width: 250px;
            background: var(--sidebar-bg);
            padding: 20px 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            padding: 0 20px 30px;
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        .sidebar-logo i {
            font-size: 32px;
            margin-right: 10px;
            color: var(--primary-color);
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
        }

        .sidebar-menu li {
            margin-bottom: 5px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            color: #94a3b8;
            text-decoration: none;
            transition: all 0.3s;
        }

        .sidebar-menu a:hover,
        .sidebar-menu a.active {
            background: var(--sidebar-hover);
            color: white;
        }

        .sidebar-menu a i {
            width: 24px;
            margin-right: 12px;
            font-size: 18px;
        }

        /* Main Content */
        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }

        /* Top Bar */
        .topbar {
            background: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--card-shadow);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .topbar-left h4 {
            margin: 0;
            color: #1e293b;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            padding: 8px 15px 8px 40px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            width: 300px;
            background: #f8fafc;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .topbar-icons {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .topbar-icons i {
            font-size: 20px;
            color: #64748b;
            cursor: pointer;
        }

        .notification-badge {
            position: relative;
        }

        .notification-badge::after {
            content: '6';
            position: absolute;
            top: -8px;
            right: -8px;
            background: #ef4444;
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .user-profile img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-info {
            text-align: right;
        }

        .user-info .name {
            font-weight: 600;
            color: #1e293b;
            font-size: 14px;
        }

        .user-info .role {
            font-size: 12px;
            color: #94a3b8;
        }

        /* Dashboard Content */
        .dashboard-content {
            padding: 30px;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card.primary {
            background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
            color: white;
        }

        .stat-info h3 {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .stat-info p {
            color: #64748b;
            font-size: 14px;
            margin: 0;
        }

        .stat-card.primary .stat-info p {
            color: rgba(255,255,255,0.8);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stat-card.primary .stat-icon {
            background: rgba(255,255,255,0.2);
        }

        .stat-icon i {
            font-size: 28px;
            color: var(--primary-color);
        }

        .stat-card.primary .stat-icon i {
            color: white;
        }

        .stat-footer {
            margin-top: 10px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .stat-footer.positive {
            color: #10b981;
        }

        .stat-footer.negative {
            color: #ef4444;
        }

        .stat-footer span {
            font-weight: 600;
        }

        /* Charts Section */
        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
        }

        .chart-card h5 {
            margin-bottom: 5px;
            color: #1e293b;
        }

        .chart-card p {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .chart-placeholder {
            height: 300px;
            background: linear-gradient(180deg, #f8fafc 0%, white 100%);
            border-radius: 8px;
            display: flex;
            align-items: flex-end;
            padding: 20px;
            gap: 15px;
        }

        .chart-bar {
            flex: 1;
            background: var(--primary-color);
            border-radius: 4px;
            opacity: 0.7;
            transition: opacity 0.3s;
        }

        .chart-bar:hover {
            opacity: 1;
        }

        .sales-report {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .sales-report h5,
        .sales-report p {
            color: white;
        }

        .sales-icon {
            width: 120px;
            height: 120px;
            margin: 20px 0;
        }

        .revenue-amount {
            font-size: 48px;
            font-weight: bold;
            margin: 20px 0;
        }

        .revenue-change {
            font-size: 16px;
            opacity: 0.9;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 70px;
            }

            .sidebar-menu a span {
                display: none;
            }

            .sidebar-logo span {
                display: none;
            }

            .main-content {
                margin-left: 70px;
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
        .sidebar-menu li a.logout-link {
    color: #dc3545;
    font-weight: 600;
    transition: 0.3s ease;
}

.sidebar-menu li a.logout-link:hover {
    background: rgba(220, 53, 69, 0.1);
    color: #b02a37;
}

    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            <span>SMARTRIDE</span>
        </div>
        <ul class="sidebar-menu">
        
        <li>
            <a href="{{ path('app_logout') }}" class="logout-link">
                <i class="bi bi-box-arrow-right"></i>
                <span>LOGOUT</span>
            </a>
        </li>
    
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="topbar">
            <div class="topbar-left">
                <h4><i class="bi bi-list"></i>SmartRide Admin Dashboard</h4>
            </div>
            <div class="topbar-right">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search">
                </div>
                <div class="topbar-icons">
                    <i class="bi bi-cart3"></i>
                    <i class="bi bi-bell notification-badge"></i>
                    <i class="bi bi-grid"></i>
                </div>
                <div class="user-profile">
                    <img src="{{ asset('images/mohamed.jpg') }}" alt="Background Image" />
                    <div class="user-info">
                        <div class="name">Mohamed Oueslati</div>
                        <div class="role">Admin</div>
                    </div>
                </div>
            </div>
        </div>
        {% block body %}
        <!-- Dashboard Content -->
        <div class="dashboard-content">
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <h3>3300</h3>
                        <p>Items</p>
                        <div class="stat-footer positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>+40%</span>
                            <span style="color: #94a3b8;">this month</span>
                        </div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h3>6600</h3>
                        <p>Orders</p>
                        <div class="stat-footer positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>+30%</span>
                            <span style="color: #94a3b8;">this month</span>
                        </div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h3>9900</h3>
                        <p>Themes</p>
                        <div class="stat-footer positive">
                            <i class="bi bi-arrow-up"></i>
                            <span>+60%</span>
                            <span style="color: #94a3b8;">this month</span>
                        </div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-palette"></i>
                    </div>
                </div>

                <div class="stat-card primary">
                    <div class="stat-info">
                        <h3>8800</h3>
                        <p>Payments</p>
                        <div class="stat-footer" style="color: white;">
                            <i class="bi bi-arrow-up"></i>
                            <span>+20%</span>
                            <span>this month</span>
                        </div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-credit-card-2-front"></i>
                    </div>
                </div>
            </div>
           {% endblock %}
           

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
