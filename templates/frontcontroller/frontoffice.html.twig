<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>SMARTRIDE</title>
    <title>SmartRide</title>

  <!-- Favicon -->
  {# The favicon is located at public/assets/assets/favicon.ico in this project. #}
  <link rel="icon" type="image/x-icon" href="{{ asset('assets/assets/favicon.ico') }}?v={{ 'now'|date('U') }}" />

    <!-- Font Awesome icons -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

    <!-- Google fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic" rel="stylesheet" />

  <!-- Core theme CSS -->
  {# The compiled stylesheet lives under public/assets/css/styles.css #}
  <link rel="stylesheet" href="{{ asset('css/style.css') }}">
  </head>

  <body id="page-top">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg bg-secondary text-uppercase fixed-top" id="mainNav">
      <div class="container">
        <a class="navbar-brand" href="#page-top">SmartRide</a>
        <button class="navbar-toggler text-uppercase font-weight-bold bg-primary text-white rounded"
          type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive"
          aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
          Menu <i class="fas fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="navbar-nav ms-auto">
            {% if app.user %}
                <li class="nav-item mx-0 mx-lg-1"><a class="nav-link" href="{{ path('app_reclamation_index') }}">Reclamation</a></li>
            {% endif %}
            
            <li class="nav-item mx-0 mx-lg-1"><a class="nav-link" href="#about">About Us</a></li>
            <li class="nav-item mx-0 mx-lg-1"><a class="nav-link" href="#contact">Contact</a></li>
            
            {% if app.user %}
                <li class="nav-item mx-0 mx-lg-1"><a class="nav-link" href="#portfolio">Profile</a></li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a href="{{ path('app_logout') }}" class="nav-link logout-link">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </li>
            {% else %}
                <li class="nav-item mx-0 mx-lg-1">
                    <a href="{{ path('app_login') }}" class="nav-link">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login</span>
                    </a>
                </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </nav>

    <!-- Masthead -->
    <header class="masthead bg-primary text-white text-center">
      <div class="container d-flex align-items-center flex-column">
  {# avataaars.svg is inside public/assets/assets/img/ #}
  <img class="masthead-avatar mb-5" src="{{ asset('assets/assets/img/avataaars.svg') }}?v={{ 'now'|date('U') }}" alt="Avatar" />
        <h1 class="masthead-heading text-uppercase mb-0">SMARTRIDE</h1>
        <div class="divider-custom divider-light">
          <div class="divider-custom-line"></div>
          <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
          <div class="divider-custom-line"></div>
        </div>
        <p class="masthead-subheading font-weight-light mb-0">Share the road, save lives.</p>
      </div>
    </header>

    <!-- Portfolio Section -->
    <section class="page-section portfolio" id="portfolio">
      <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Reclamation</h2>
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Profile</h2>
        <div class="divider-custom">
          <div class="divider-custom-line"></div>
          <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
          <div class="divider-custom-line"></div>
        </div>

        <div class="row justify-content-center">
          <div class="col-md-6 col-lg-4 mb-5">
            <div class="portfolio-item mx-auto">
              <img class="img-fluid" src="{{ asset('assets/assets/img/portfolio/cabin.png') }}?v={{ 'now'|date('U') }}" alt="Cabin" />
            </div>
          </div>

          <div class="col-md-6 col-lg-4 mb-5">
            <div class="portfolio-item mx-auto">
              <img class="img-fluid" src="{{ asset('assets/assets/img/portfolio/cake.png') }}?v={{ 'now'|date('U') }}" alt="Cake" />
            </div>
          </div>

          <div class="col-md-6 col-lg-4 mb-5">
            <div class="portfolio-item mx-auto">
              <img class="img-fluid" src="{{ asset('assets/assets/img/portfolio/circus.png') }}?v={{ 'now'|date('U') }}" alt="Circus" />
            </div>
          </div>
           </div>

  <div class="container mt-3">
      {% for label, messages in app.flashes %}
          {% for message in messages %}
              <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                  {{ message }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
          {% endfor %}
      {% endfor %}
  </div>

  {% block body %}{% endblock %} 
    
  </div>
        </div>
      </div>
     
          <div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="page-section bg-primary text-white mb-0" id="about">
      <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-white">Qui sommes-nous</h2>
        <h2 class="page-section-heading text-center text-uppercase text-white">About</h2>
        <div class="divider-custom divider-light">
          <div class="divider-custom-line"></div>
          <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
          <div class="divider-custom-line"></div>
        </div>
        <div class="row">
  <div class="col-lg-8 mx-auto">
    <p class="lead text-center">
      Notre application vous permet de partager vos trajets avec d’autres passagers,  
      réduire vos frais de transport et contribuer à un environnement plus propre.
    </p>
  </div>
</div>
            <p class="lead">Notre application permet de partager vos trajets avec d’autres passagers, réduire vos frais de transport et contribuer à un environnement plus propre.</p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="page-section" id="contact">
      <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Contact Us</h2>
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Contact Me</h2>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer text-center">
      <div class="container">
        <p class="text-secondary mb-0">© Freelancer Theme - Symfony Integration</p>
      </div>
    </footer>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {# The compiled JS lives under public/assets/js/scripts.js #}
    <script src="{{ asset('assets/js/scripts.js') }}"></script>
  </body>
</html>
