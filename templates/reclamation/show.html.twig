{% extends 'frontcontroller/frontoffice.html.twig' %}
{% block title %}Reclamation{% endblock %}

{% block body %}
<div style="text-align: center; margin-top: 50px;">
    <h1 style="
        font-size: 32px;           /* taille réduite */
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 12px 20px;
        border-radius: 15px;
        background-color: #2c3e50;
        color: #1abc9c;
        display: inline-block;
        animation: pulse 2s ease-in-out 1 forwards, colorShift 4s ease-in-out 1 forwards;
    ">
        Informations sur la réclamation
    </h1>
</div>

<style>
@keyframes pulse {
    0% {transform: scale(1);}
    50% {transform: scale(1.05);}
    100% {transform: scale(1);}
}

@keyframes colorShift {
    0% {color: #1abc9c;}
    50% {color: #16a085;}
    100% {color: #1abc9c;}
}
</style>
 

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reclamation.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ reclamation.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ reclamation.prenom }}</td>
            </tr>
            <tr>
                <th>Type_reclamation</th>
                <td>{{ reclamation.typeReclamation.value }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ reclamation.message }}</td>
            </tr>
            <tr>
                <th>Date_reclamation</th>
                <td>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="button-group">
        <!--retour a la liste -->
        <a href="{{ path('app_reclamation_index') }}" class="btn-custom">Retour à la Liste</a>

        <!-- Modifier -->
        <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn-custom">Modifier</a>

        <!-- Supprimer -->
        <form method="post" action="{{ path('app_reclamation_delete', {'id': reclamation.id}) }}"
              onsubmit="return confirm('Are you sure you want to delete this item?');"
              style="display:inline-block; margin:0;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
            <button type="submit" class="btn-custom btn-delete">Supprimer</button>
        </form>
    </div>
{% endblock %}
