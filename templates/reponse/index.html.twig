{% extends 'admincontroller/admindashboard.html.twig' %}

{% block title %}Liste des réponses{% endblock %}

{% block body %}
<div style="max-width:1000px; margin:40px auto;">

    <h1 style="text-align:center; font-size:36px; font-weight:700; color:#2c3e50; margin-bottom:30px;">
        Liste des réponses
    </h1>
<input type="text" id="searchReponse" placeholder="Rechercher une réponse..."
       class="form-control mb-3"
       style="
            border: 2px solid #1e40af;
            border-radius: 8px;
            padding: 10px;
            font-weight: 500;
            color: #1e40af;
       ">

<div id="resultsReponse" style="
            background: #f8fafc;
            border: 1px solid #1e40af;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 4px 12px rgba(30,64,175,0.15);
">
    <div style="display:flex; flex-direction:column; gap:20px;">
        {% for reponse in reponses %}
            <div style="padding:20px; background:#f7f7f7; border-radius:10px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">

                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span>{{ reponse.dateReponse ? reponse.dateReponse|date('d/m/Y') : '' }}</span>
                </div>

                <p><strong>Nom et Prenom:</strong> {{ reponse.reclamation.nom }} {{ reponse.reclamation.prenom }}</p>
                <p><strong>Type :</strong> {{ reponse.reclamation.typeReclamation.value }}</p>
                <p><strong>Réclamation :</strong> {{ reponse.reclamation.message }}</p>
                <p><strong>Réponse :</strong> {{ reponse.contenu }}</p>
                <p><strong>Date réclamation :</strong> {{ reponse.reclamation.dateReclamation ? reponse.reclamation.dateReclamation|date('d/m/Y') : '' }}</p>

                <div style="margin-top:10px; display:flex; gap:10px;">
                    <a href="{{ path('app_reponse_show', {'id': reponse.id}) }}"
                       style="padding:6px 14px; background:#2c3e50; color:white; border-radius:6px; text-decoration:none;">Détails</a>
                    <a href="{{ path('app_reponse_edit', {'id': reponse.id}) }}"
                       style="padding:6px 14px; background:#34495e; color:white; border-radius:6px; text-decoration:none;">Modifier</a>
                </div>

            </div>
        {% endfor %}
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const input = document.getElementById('searchReponse');
    const container = document.getElementById('resultsReponse');

    function renderCards(data) {
        if (data.length === 0) {
            container.innerHTML =
                '<p style="text-align:center; padding:20px; background:#f7f7f7; border-radius:10px;">Aucune réponse trouvée.</p>';
            return;
        }

        let html = '<div style="display:flex; flex-direction:column; gap:20px;">';

        data.forEach(rep => {
            html += `
                <div style="padding:20px; background:#f7f7f7; border-radius:10px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
                    
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <span>${rep.date_reponse}</span>
                    </div>

                    <p><strong>Nom et Prenom:</strong> ${rep.reclamation_nom} ${rep.reclamation_prenom}</p>
                    <p><strong>Type :</strong> ${rep.reclamation_type}</p>
                    <p><strong>Réclamation :</strong> ${rep.reclamation_message}</p>
                    <p><strong>Réponse :</strong> ${rep.contenu}</p>
                    <p><strong>Date réclamation :</strong> ${rep.reclamation_date}</p>

                    <div style="margin-top:10px; display:flex; gap:10px;">
                        <a href="/reponse/${rep.id}" 
                           style="padding:6px 14px; background:#2c3e50; color:white; border-radius:6px; text-decoration:none;">Détails</a>
                        <a href="/reponse/${rep.id}/edit"
                           style="padding:6px 14px; background:#34495e; color:white; border-radius:6px; text-decoration:none;">Modifier</a>
                    </div>
                </div>
            `;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    input.addEventListener('keyup', function () {
        const q = input.value;

        fetch("{{ path('app_reponse_index') }}?q=" + encodeURIComponent(q), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(res => res.json())
            .then(data => renderCards(data));
    });

});
</script>


    <div style="text-align:center; margin-top:30px;">
        <a href="{{ path('app_reponse_new') }}"
           style="display:inline-block; padding:12px 28px; background:#2c3e50; color:white; font-size:16px; font-weight:600; border-radius:8px; text-decoration:none;">
           ➕ Créer une nouvelle réponse
        </a>
    </div>

</div>
{% endblock %}
