{% extends 'admincontroller/admindashboard.html.twig' %}

{% block title %}Détails de la réponse{% endblock %}

{% block body %}
<div style="max-width:800px; margin: 40px auto; padding: 20px; background-color:#f4f6f8; border-radius:12px; box-shadow:0 4px 15px rgba(0,0,0,0.1);">

    <h1 style="text-align:center; font-size:36px; font-weight:700; color:#2c3e50; margin-bottom:30px;">
        Détails de la réponse
    </h1>

    <table style="width:100%; border-collapse:collapse; margin-bottom:30px; font-family:Arial, sans-serif;">
        <tbody>
            <tr style="background-color:#ecf0f1;">
                <th style="padding:12px; text-align:left; width:30%;">Contenu de la réponse</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">{{ reponse.contenu }}</td>
            </tr>
            <tr>
                <th style="padding:12px; text-align:left; background-color:#ecf0f1;">Date de réponse</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">
                    {{ reponse.dateReponse ? reponse.dateReponse|date('d/m/Y') : '' }}
                </td>
            </tr>
            <tr>
                <th style="padding:12px; text-align:left; background-color:#ecf0f1;">Nom et Prénom</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">
                    {{ reponse.reclamation.nom }} {{ reponse.reclamation.prenom }}
                </td>
            </tr>
            <tr>
                <th style="padding:12px; text-align:left; background-color:#ecf0f1;">Type de réclamation</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">
                    {{ reponse.reclamation.typeReclamation.value }}
                </td>
            </tr>
            <tr>
                <th style="padding:12px; text-align:left; background-color:#ecf0f1;">Message de la réclamation</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">
                    {{ reponse.reclamation.message }}
                </td>
            </tr>
            <tr>
                <th style="padding:12px; text-align:left; background-color:#ecf0f1;">Date de réclamation</th>
                <td style="padding:12px; border-bottom:1px solid #bdc3c7;">
                    {{ reponse.reclamation.dateReclamation ? reponse.reclamation.dateReclamation|date('d/m/Y') : '' }}
                </td>
            </tr>
        </tbody>
    </table>

    <div style="text-align:center; display:flex; justify-content:center; gap:15px; flex-wrap:wrap;">
        <a href="{{ path('app_reponse_index') }}"
           style="display:inline-block; padding:12px 28px; background:#2c3e50; color:white; border-radius:8px; text-decoration:none;">
            Retour à la liste
        </a>

        <a href="{{ path('app_reponse_edit', {'id': reponse.id}) }}"
           style="display:inline-block; padding:12px 28px; background:#34495e; color:white; border-radius:8px; text-decoration:none;">
            Modifier
        </a>

        <form method="post" action="{{ path('app_reponse_delete', {'id': reponse.id}) }}"
              onsubmit="return confirm('Voulez-vous vraiment supprimer cette réponse ?');"
              style="display:inline-block; margin:0;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
            <button type="submit"
                style="padding:12px 28px; background:#e74c3c; color:white; border-radius:8px; border:none; cursor:pointer;">
                Supprimer
            </button>
        </form>
    </div>

</div>
{% endblock %}
