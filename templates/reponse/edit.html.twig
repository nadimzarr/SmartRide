{% extends 'admincontroller/admindashboard.html.twig' %}

{% block title %}Edit Response{% endblock %}

{% block body %}
<div style="max-width:650px; margin:40px auto; padding:30px; background:#ffffff; border-radius:15px; box-shadow:0 8px 25px rgba(0,0,0,0.08); font-family:Arial, sans-serif;">

    <h1 style="text-align:center; font-size:34px; font-weight:700; color:#2c3e50; margin-bottom:30px;">
        Edit Response
    </h1>

    {{ form_start(form, {'attr': {'style': 'display:flex; flex-direction:column; gap:20px;'}}) }}

        {% for field in form %}
            <div style="display:flex; flex-direction:column;">
                {{ form_label(field, null, {'label_attr': {'style':'font-weight:600; color:#34495e; margin-bottom:6px;'}}) }}
                {{ form_widget(field, {'attr': {'style':'padding:12px 14px; border-radius:10px; border:1px solid #ccc; font-size:16px; transition: border 0.2s;'}}) }}
                {{ form_errors(field, {'attr': {'style':'color:#e74c3c; margin-top:4px; font-size:14px;'}}) }}
            </div>
        {% endfor %}

        <div style="display:flex; justify-content:center; gap:15px; flex-wrap:wrap; margin-top:25px;">
            <button type="submit"
                style="
                    padding:12px 30px;
                    background: linear-gradient(135deg, #2980b9, #3498db);
                    color:white;
                    font-size:16px;
                    font-weight:600;
                    border-radius:12px;
                    border:none;
                    cursor:pointer;
                    box-shadow:0 6px 15px rgba(0,0,0,0.1);
                    transition: all 0.25s ease;
                "
                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.15)';"
                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 15px rgba(0,0,0,0.1)';"
            >
                Update
            </button>

            <a href="{{ path('app_reponse_index') }}"
               style="
                    display:inline-block;
                    padding:12px 30px;
                    background:#95a5a6;
                    color:white;
                    font-size:16px;
                    font-weight:600;
                    border-radius:12px;
                    text-decoration:none;
                    text-align:center;
                    box-shadow:0 6px 15px rgba(0,0,0,0.1);
                    transition: all 0.25s ease;
               "
               onmouseover="this.style.background='#7f8c8d'; this.style.transform='translateY(-2px)';"
               onmouseout="this.style.background='#95a5a6'; this.style.transform='translateY(0)';"
            >
                Back to list
            </a>
        </div>

    {{ form_end(form) }}

    <div style="text-align:center; margin-top:30px;">
        <form method="post" action="{{ path('app_reponse_delete', {'id': reponse.id}) }}"
              onsubmit="return confirm('Voulez-vous vraiment supprimer cette réponse ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reponse.id) }}">
            <button type="submit"
                style="
                    padding:12px 30px;
                    background: linear-gradient(135deg, #e74c3c, #c0392b);
                    color:white;
                    font-size:16px;
                    font-weight:600;
                    border-radius:12px;
                    border:none;
                    cursor:pointer;
                    box-shadow:0 6px 15px rgba(0,0,0,0.1);
                    transition: all 0.25s ease;
                "
                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.15)';"
                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 15px rgba(0,0,0,0.1)';"
            >
                Supprimer
            </button>
        </form>
    </div>

</div>
{% endblock %}
